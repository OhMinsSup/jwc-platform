{
	"name": "@jwc/typecheck",
	"version": "0.0.0",
	"private": true,
	"description": "타입 검증 진입점. 검증된 플랫폼에서는 tsrs, 그 외에는 tsc로 같은 tsconfig를 검사한다.",
	"bin": {
		"jwc-typecheck": "./src/cli.mjs"
	},
	"type": "module",
	"scripts": {
		"test": "vp test run",
		"typecheck": "node src/cli.mjs --noEmit",
		"typecheck:tsc": "tsc --noEmit"
	},
	"dependencies": {
		"tsrs": "catalog:",
		"typescript": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"vite-plus": "catalog:"
	}
}
