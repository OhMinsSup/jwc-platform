{
	"$schema": "https://turborepo.org/schema.json",
	"ui": "tui",
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".void/**"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"outputs": [".cache/tsbuildinfo.json"]
		},
		"typecheck:tsc": {
			"dependsOn": ["^typecheck:tsc"],
			"outputs": [".cache/tsbuildinfo.json"]
		},
		"clean": {
			"cache": false
		},
		"env:sync": {
			"cache": false,
			"interactive": true
		},
		"deploy": {
			"cache": false,
			"interactive": true
		},
		"deploy:production": {
			"cache": false,
			"interactive": true
		}
	},
	"globalPassThroughEnv": ["NODE_ENV", "CI"]
}
