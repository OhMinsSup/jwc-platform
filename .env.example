# 실제 개발 연동에만 사용: config/env/.env.development로 복사해 채운 뒤
# pnpm -C apps/web env:encrypt → env:keychain 순서로 실행합니다.
# 기본 pnpm dev는 config/env/development.env의 더미 설정을 사용합니다.
SITE_URL=http://localhost:5173
BETTER_AUTH_SECRET=
ADMIN_EMAILS=admin@example.org
ADMIN_SIGNUP_ENABLED=true

# 이메일별 SMS 인증 번호 (쉼표 구분). 실제 관리자 번호로 바꿉니다.
ADMIN_PHONES=admin@example.org=01000000000

# 개인정보 암호화 키: openssl rand -base64 32
DATA_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@example.org
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
SUBMISSION_STORE=sheets

SMS_MODE=log
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
