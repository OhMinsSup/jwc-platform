{
	"name": "jwc-forms",
	"private": true,
	"keywords": [
		"jwc"
	],
	"license": "ISC",
	"author": "OhMinsSup",
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"check": "vp check",
		"check:deps": "syncpack lint",
		"check:unused": "knip",
		"clean": "git clean -xdf node_modules",
		"deploy": "turbo run deploy --filter=web --env-mode=loose",
		"deploy:production": "turbo run deploy:production --filter=web --env-mode=loose",
		"dev": "turbo run dev",
		"env:sync": "turbo run env:sync --filter=web --env-mode=loose",
		"fix": "vp check --fix",
		"fix:deps": "syncpack fix",
		"format": "vp fmt",
		"lint": "vp lint",
		"lint:ws": "pnpm dlx sherif@latest",
		"prepare": "vp config --hooks --no-agent",
		"test": "vp test run",
		"typecheck": "node tooling/typecheck/src/cli.mjs --noEmit -p scripts/security && turbo run typecheck",
		"typecheck:tsc": "tsc --noEmit -p scripts/security && turbo run typecheck:tsc",
		"verify": "pnpm check && pnpm check:deps && pnpm check:unused && pnpm typecheck && pnpm test",
		"security": "node scripts/security/cli.ts all",
		"security:setup": "python3 -m venv --copies .cache/security-tools && .cache/security-tools/bin/python -m pip install -r scripts/security/requirements.txt",
		"security:audit": "node scripts/security/cli.ts audit",
		"security:osv": "node scripts/security/cli.ts osv",
		"security:code": "node scripts/security/cli.ts code",
		"security:malware": "node scripts/security/cli.ts malware",
		"security:install": "sfw pnpm install --frozen-lockfile",
		"security:snyk": "pnpm dlx snyk@1.1308.4 test --all-projects --dev",
		"security:snyk:auth": "pnpm dlx snyk@1.1308.4 auth"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"jsdom": "catalog:",
		"knip": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"sfw": "2.0.6",
		"syncpack": "catalog:",
		"turbo": "^2.11.10",
		"typescript": "catalog:",
		"ultracite": "catalog:",
		"vite-plus": "catalog:",
		"yaml": "2.9.1",
		"zod": "catalog:"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@10.34.9"
}
