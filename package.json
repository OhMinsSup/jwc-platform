{
	"name": "jwc-forms",
	"private": true,
	"keywords": [
		"jwc"
	],
	"license": "ISC",
	"author": "OhMinsSup",
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"check": "vp check",
		"check:deps": "syncpack lint",
		"check:unused": "knip",
		"clean": "git clean -xdf node_modules",
		"dev": "turbo run dev",
		"fix": "vp check --fix",
		"fix:deps": "syncpack fix",
		"format": "vp fmt",
		"lint": "vp lint",
		"lint:ws": "pnpm dlx sherif@latest",
		"prepare": "vp config --hooks --no-agent",
		"test": "vp test run",
		"typecheck": "turbo run typecheck",
		"typecheck:tsc": "turbo run typecheck:tsc",
		"verify": "pnpm check && pnpm check:deps && pnpm check:unused && pnpm typecheck && pnpm test"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"jsdom": "catalog:",
		"knip": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"syncpack": "catalog:",
		"turbo": "^2.11.10",
		"typescript": "catalog:",
		"ultracite": "catalog:",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@10.34.9"
}
