{
	"extends": "./.void/tsconfig.json",
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": false,
		"noEmit": true,
		"types": ["void/env", "@cloudflare/workers-types", "vite/client"]
	},
	"include": [
		"src",
		"db",
		"crons",
		"queues",
		"test",
		"env.ts",
		"server.ts",
		"vite.config.ts",
		"void.config.ts"
	]
}
