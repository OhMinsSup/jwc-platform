{
	"extends": "./.void/tsconfig.json",
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": false,
		"noEmit": true,
		"types": ["void/env", "vite/client"],
		"paths": {
			"void/db": ["./.void/db.d.ts"],
			"@schema": ["./db/schema.ts"],
			"@schema/*": ["./db/schema/*"],
			"void/queues": ["./.void/queues.d.ts"]
		}
	},
	"include": [
		"src",
		"db",
		"crons",
		"queues",
		"scripts",
		"test",
		"env.ts",
		"server.ts",
		"vite.config.ts",
		"void.config.ts"
	],
	"files": ["./.void/db.d.ts", "./.void/queues.d.ts", "./.void/env.d.ts"]
}
