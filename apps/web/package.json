{
	"name": "web",
	"private": true,
	"type": "module",
	"scripts": {
		"auth:schema": "pnpm dlx @better-auth/cli@latest generate --output ./db/better-auth.generated.ts",
		"build": "vp build",
		"codegen": "void prepare",
		"db:generate": "void db generate",
		"db:migrate": "void db migrate",
		"deploy": "void deploy",
		"deploy:production": "pnpm run env:sync && pnpm run deploy",
		"dev": "pnpm with-env vp dev",
		"env:sync": "void secret sync ../../config/env/production/.env",
		"preview": "pnpm with-env vp preview",
		"test": "vp test run",
		"test:e2e": "pnpm with-env:test playwright test",
		"test:e2e:install": "playwright install --with-deps --only-shell chromium",
		"test:performance": "pnpm with-env:performance playwright test --config playwright.performance.config.ts",
		"typecheck": "void prepare && jwc-typecheck --noEmit && jwc-typecheck --noEmit -p e2e",
		"typecheck:tsc": "void prepare && tsc --noEmit && tsc --noEmit -p e2e",
		"with-env": "dotenv --no-expand -o -e ../../config/env/development/.env --",
		"with-env:test": "dotenv --no-expand -o -e ../../config/env/test/defaults.env --",
		"with-env:performance": "dotenv --no-expand -o -e ../../config/env/performance/.dev.vars --",
		"db:seed-admin": "pnpm with-env tsx scripts/seed-dev-admin.ts",
		"db:admin-code": "pnpm with-env tsx scripts/dev-admin-code.ts"
	},
	"dependencies": {
		"@jwc/analytics": "workspace:*",
		"@jwc/common": "workspace:*",
		"@jwc/form-core": "workspace:*",
		"@jwc/google": "workspace:*",
		"@jwc/observability": "workspace:*",
		"@jwc/security": "workspace:*",
		"@jwc/submission-store": "workspace:*",
		"@jwc/ui": "workspace:*",
		"@jwc/ui-patterns": "workspace:*",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-start": "^1.169.5",
		"better-auth": "^1.7.18",
		"drizzle-orm": "^0.45.4",
		"lucide-react": "catalog:",
		"qrcode.react": "^4.2.0",
		"react": "catalog:react19",
		"react-dom": "catalog:react19",
		"zod": "catalog:",
		"zustand": "^5.1.0"
	},
	"devDependencies": {
		"@jwc/typecheck": "workspace:*",
		"@playwright/test": "^1.65.0",
		"@tailwindcss/vite": "catalog:frontend",
		"@types/node": "catalog:",
		"@types/react": "catalog:react19",
		"@types/react-dom": "catalog:react19",
		"@vitejs/plugin-react": "^6.3.0",
		"dotenv-cli": "11.1.0",
		"tsx": "^4.23.15",
		"typescript": "catalog:",
		"vite": "^8.3.5",
		"vite-plus": "catalog:",
		"void": "^1.7.0",
		"web-vitals": "6.2.3"
	}
}
