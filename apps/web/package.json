{
	"name": "web",
	"private": true,
	"type": "module",
	"scripts": {
		"auth:schema": "pnpm dlx @better-auth/cli@latest generate --output ./db/better-auth.generated.ts",
		"build": "vp build",
		"codegen": "void prepare",
		"db:generate": "void db generate",
		"db:migrate": "void db migrate",
		"deploy": "void deploy",
		"dev": "pnpm with-env vp dev",
		"dev:real": "pnpm with-env:real vp dev",
		"env:encrypt": "dotenvx encrypt --no-create --no-armor --no-native --no-1password --no-bitwarden -f ../../config/env/.env.development -fk ../../config/env/.env.keys",
		"env:keychain": "dotenvx native up -f ../../config/env/.env.development -fk ../../config/env/.env.keys",
		"preview": "pnpm with-env vp preview",
		"test": "vp test run",
		"test:e2e": "pnpm with-env playwright test",
		"test:e2e:install": "playwright install --with-deps --only-shell chromium",
		"typecheck": "void prepare && jwc-typecheck --noEmit && jwc-typecheck --noEmit -p e2e",
		"typecheck:tsc": "void prepare && tsc --noEmit && tsc --noEmit -p e2e",
		"with-env": "dotenvx run --strict --overload --no-armor --no-native --no-1password --no-bitwarden -f ../../config/env/development.env --",
		"with-env:real": "dotenvx run --strict --overload --redact --no-armor --no-1password --no-bitwarden -f ../../config/env/.env.development --"
	},
	"dependencies": {
		"@jwc/analytics": "workspace:*",
		"@jwc/common": "workspace:*",
		"@jwc/form-core": "workspace:*",
		"@jwc/google": "workspace:*",
		"@jwc/observability": "workspace:*",
		"@jwc/security": "workspace:*",
		"@jwc/submission-store": "workspace:*",
		"@jwc/ui": "workspace:*",
		"@jwc/ui-patterns": "workspace:*",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-start": "^1.169.4",
		"better-auth": "^1.7.17",
		"drizzle-orm": "^0.45.4",
		"lucide-react": "catalog:",
		"qrcode.react": "^4.2.0",
		"react": "catalog:react19",
		"react-dom": "catalog:react19",
		"zod": "catalog:",
		"zustand": "^5.0.16"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261104.1",
		"@dotenvx/dotenvx": "2.38.2",
		"@jwc/typecheck": "workspace:*",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/vite": "catalog:frontend",
		"@types/node": "catalog:",
		"@types/react": "catalog:react19",
		"@types/react-dom": "catalog:react19",
		"@vitejs/plugin-react": "^6.2.1",
		"typescript": "catalog:",
		"vite": "^8.3.5",
		"vite-plus": "catalog:",
		"void": "^1.6.2"
	}
}
