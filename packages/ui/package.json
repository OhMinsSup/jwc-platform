{
	"name": "@jwc/ui",
	"version": "0.1.0",
	"private": true,
	"description": "shadcn(base-nova) + Base UI 기반 공용 컴포넌트.",
	"license": "MIT",
	"type": "module",
	"exports": {
		"./globals.css": "./src/styles/globals.css",
		"./lib/*": "./src/lib/*.ts",
		"./components/*": "./src/components/*.tsx",
		"./hooks/*": "./src/hooks/*.ts"
	},
	"scripts": {
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"typecheck": "jwc-typecheck --noEmit",
		"typecheck:tsc": "tsc --noEmit",
		"ui-add": "pnpm dlx shadcn@latest add && pnpm -w exec vp check --fix packages/ui/src"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
