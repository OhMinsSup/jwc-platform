					}
				}
			]
		},
		"TypeScript": {
			"language_servers": [
				"typescript-ls",
				"!vtsls",
				"!typescript-language-server",
				"..."
			],
			"format_on_save": "on",
			"prettier": {
				"allowed": false
			},
			"formatter": [
				{
