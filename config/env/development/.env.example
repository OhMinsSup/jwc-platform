# 실제 개발 연동용 예시입니다. 같은 폴더의 .env로 복사해 개발용 값을 채웁니다.
# .env는 Git에서 제외합니다. 실제 값을 AI나 로그에 제공하지 않습니다.
# pnpm dev는 이 폴더의 .env를 사용합니다.
SITE_URL=http://localhost:5173
BETTER_AUTH_SECRET=
ADMIN_EMAILS=admin@example.org
ADMIN_SIGNUP_ENABLED=true

# 이메일별 SMS 인증 번호 (쉼표 구분). 실제 관리자 번호로 바꿉니다.
ADMIN_PHONES=admin@example.org=01000000000

# 개인정보 암호화 키: openssl rand -base64 32
DATA_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@example.org
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
SUBMISSION_STORE=sheets

SMS_MODE=log
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=

# PostHog browser analytics (public project key and ingestion host)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# 선택: 봇 방지 검증에 사용할 개발용 키
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
