# 공개 개발 설정이다. 실제 비밀값을 넣지 않는다.
# --overload로 상속된 실제 연동 설정도 덮는다. 운영에는 사용하지 않는다.
SITE_URL=http://localhost:5173
BETTER_AUTH_SECRET=development-only-not-a-secret-0123456789abcdef
ADMIN_EMAILS=admin@example.org
ADMIN_PHONES=
ADMIN_SIGNUP_ENABLED=true
DATA_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
GOOGLE_SERVICE_ACCOUNT_EMAIL=development@example.org
GOOGLE_PRIVATE_KEY=unused-in-memory-store
GOOGLE_SPREADSHEET_ID=unused-in-memory-store
SUBMISSION_STORE=memory
SMS_MODE=log
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 로컬 실행에 배포 권한과 Void 원격 연결을 전달하지 않는다.
CLOUDFLARE_API_TOKEN=
VOID_TOKEN=
VOID_API_URL=
VOID_REMOTE=false
VOID_ENV_UNMASK=0
