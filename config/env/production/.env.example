# 운영 Worker Secrets에 등록할 항목의 예시입니다. 실제 값은 이 파일에 넣지 않습니다.
# 같은 폴더의 .env로 복사해 값을 채우고(chmod 600) `pnpm env:sync`로 올립니다.
# 모든 키는 apps/web/env.ts에 선언돼 있어야 합니다.
SITE_URL=https://forms.example.org
BETTER_AUTH_SECRET=
ADMIN_EMAILS=admin@example.org
ADMIN_SIGNUP_ENABLED=false

# ADMIN_PHONES는 이메일=휴대전화번호 형식으로 Worker Secrets에 등록합니다.
ADMIN_PHONES=admin@example.org=01000000000

# 개인정보 암호화 키: openssl rand -base64 32
DATA_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@example.org
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
SUBMISSION_STORE=sheets

SMS_MODE=live
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=

# PostHog browser analytics (public project key and ingestion host)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# 선택: 운영 도메인에 맞는 봇 방지 키
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
